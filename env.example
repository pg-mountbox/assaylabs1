# Database
DATABASE_URL=postgresql://username:password@localhost:5432/food_lab_marketplace

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Demo Mode (set to true to allow any OTP)
DEMO_MODE=true

# Email (Resend)
RESEND_API_KEY=your-resend-api-key-here
EMAIL_SERVER=smtp://resend:your-resend-api-key@smtp.resend.com:587
EMAIL_FROM=noreply@yourdomain.com

# Microsoft Graph (for professor calendar sync)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
